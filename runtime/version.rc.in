// Version information shown in the executable's properties (generated by CMake)
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
FILEVERSION @APP_VERSION_COMMAS@,0
PRODUCTVERSION @APP_VERSION_COMMAS@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "The Apprentice@VERSION_EDITION@ (CD-i static recompilation)"
      VALUE "FileVersion", "@APP_VERSION@"
      VALUE "ProductName", "The Apprentice@VERSION_EDITION@"
      VALUE "ProductVersion", "@APP_VERSION@"
      VALUE "OriginalFilename", "@VERSION_FILE@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
